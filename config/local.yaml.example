# Copy to config/local.yaml (see .gitignore) and fill in paths.
# Merged over config/default.yaml by: scripts/train_pretrain.py --local-config config/local.yaml

dataset:
  splits:
    - name: "900kpa"
      stiffness_kpa: 900.0
      zstack_root: "/path/to/250811_Athchip_noninflam_900kPa"
      focused_root: "/path/to/20251027_2123__FocusStack_250811_Athchip_noninflam_900kPa"
      hybrid_root: "/path/to/250811_Athchip_noninflam_900kPa_HybridResults"
      labels_root: "/path/to/bbox_txt_for_training/900kPa"
    - name: "5kpa"
      stiffness_kpa: 5.0
      zstack_root: "/path/to/250814_Athchip_non-inflam_5kPa"
      focused_root: "/path/to/20251027_2215__FocusStack_250814_Athchip_non-inflam_5kPa"
      hybrid_root: "/path/to/250814_Athchip_non-inflam_5kPa_HybridResults"
      labels_root: "/path/to/bbox_txt_for_training/5kPa"
